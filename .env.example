# Server configuration
PORT=3000
NODE_ENV=development

# Dashboard authentication password (recommended for production).
# If left empty, the dashboard shows a first-run setup screen to claim an admin password.
DASHBOARD_PASSWORD=

# Webhook secret required in X-Webhook-Secret or Authorization: Bearer header on POST /api/orders.
# If left empty, you can generate and manage a server-side secret from the Configuration view.
WEBHOOK_SECRET=

# Optional comma-separated allowlist of hostnames allowed for paymentReceiptUrl downloads (e.g. cdn.example.com,xyz.supabase.co).
# When unset, all public HTTPS/HTTP hosts are permitted while loopback, private, and metadata IPs are always blocked.
RECEIPT_ALLOWED_HOSTS=

# Optional explicit path to Chrome/Chromium binary for whatsapp-web.js / Puppeteer.
PUPPETEER_EXECUTABLE_PATH=

# Optional initial WhatsApp numbers (used as defaults when initializing the database).
DEFAULT_SENDER_NUMBER=01204457813
DEFAULT_RECIPIENT_NUMBER=010 15678913
DEFAULT_COUNTRY_CODE=20
